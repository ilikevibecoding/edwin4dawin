{
  "name": "starfall-opening",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A procedurally generated, browser-based interactive cinematic inspired by the opening of a classic space-opera film. All geometry, audio and narration are original and generated in code.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "narration": "node scripts/generate-narration.mjs",
    "qa": "node scripts/qa-tour.mjs",
    "qa:build": "npm run build && node scripts/qa-tour.mjs --preview"
  },
  "dependencies": {
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/three": "^0.169.0",
    "puppeteer-core": "^23.6.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
