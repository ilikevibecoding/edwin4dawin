{
  "name": "detroit-divergence",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A cinematic branching-narrative android drama in the browser, built with Three.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "shoot": "node scripts/shoot.mjs",
    "film": "node scripts/film.mjs"
  },
  "devDependencies": {
    "@types/three": "^0.185.4",
    "puppeteer-core": "^24.10.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "dependencies": {
    "three": "^0.185.1"
  }
}
