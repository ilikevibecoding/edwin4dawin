{
  "name": "northstar-rescue",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Northstar Rescue - a single-player tactical office FPS vertical slice built with Three.js + TypeScript",
  "scripts": {
    "start": "vite --host 127.0.0.1 --port 5173",
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:smoke": "playwright test tests/01-boot.spec.ts",
    "test:report": "playwright show-report"
  },
  "dependencies": {
    "three": "0.185.1",
    "three-mesh-bvh": "0.9.13"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@types/node": "^22.20.1",
    "@types/three": "0.185.0",
    "typescript": "5.9.3",
    "vite": "8.1.5"
  }
}
