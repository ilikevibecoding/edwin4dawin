{
  "name": "starfall-opening",
  "private": true,
  "version": "1.0.0",
  "description": "A procedurally generated, browser-based interactive cinematic inspired by the opening of Star Wars: A New Hope. Original fan work; no proprietary assets.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "narration": "python3 scripts/generate_narration.py",
    "qa": "node scripts/qa-tour.mjs",
    "qa:build": "npm run build && node scripts/qa-tour.mjs --preview",
    "qa:gait": "node scripts/qa-gait.mjs",
    "qa:audio": "node scripts/qa-audio.mjs"
  },
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/three": "^0.185.0",
    "playwright": "^1.50.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
