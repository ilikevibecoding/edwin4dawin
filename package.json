{
  "name": "northstar-rescue",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Northstar Rescue - a single-player tactical office FPS running in the browser.",
  "scripts": {
    "start": "vite --host 127.0.0.1 --port 5173",
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "shots": "node tools/capture-matrix.mjs",
    "build:cdn": "NS_NO_SOURCEMAP=1 vite build && node tools/bundle-single.mjs"
  },
  "dependencies": {
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "vite": "^5.4.0"
  }
}
