 "definitions": {
  "L": "L(alpha) = ceil((2*alpha-1)/3)",
  "WR_r": "p_{r-1} <= r*p_r, 1<=r<=alpha",
  "ISO_r": "Q_r = r*p_r^2 + p_{r-1}^2 - (r+1)*p_{r-1}*p_{r+1} >= 0, 1<=r<=alpha-1",
