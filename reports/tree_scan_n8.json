  "ratio": "Q_r / (p_{r-1}*p_r), exact fraction num/den (unreduced) and reduced",
  "lc_fail": "p_{k-1}*p_{k+1} > p_k^2",
  "unimodal": "nondecreasing then nonincreasing",
  "first_descent": "d = min r in 1..alpha with p_r < p_{r-1}; 0 = no descent"
 }
