{
 "task": "certify the WR/ISO-prefix + decreasing-tail => unimodal reduction (Erd\u0151s #993 project)",
 "lemma": "Let p_0, ..., p_alpha be positive integers (alpha >= 0) and, for alpha >= 1, L = ceil((2 alpha - 1)/3). Assume WR_r: p_{r-1} <= r p_r and ISO_r: r p_r^2 + p_{r-1}^2 - (r+1) p_{r-1} p_{r+1} >= 0 for every 1 <= r <= L-1, and p_r >= p_{r+1} for every L <= r <= alpha-1. Then (p_r) is unimodal: there is an m with p_0 <= ... <= p_m >= ... >= p_alpha. More precisely, with r_0 the first index in 1..L-1 with p_{r_0} <= p_{r_0-1} (if any): p is strictly increasing on [0, r_0-1] and non-increasing on [r_0-1, alpha]; if there is no such r_0, p is strictly increasing on [0, L-1] and non-increasing on [L, alpha].",
 "definitions": {
  "L(alpha)": "ceil((2 alpha - 1)/3) for alpha >= 1; 0 for alpha = 0",
  "prefix": "r = 1 .. L-1 (WR_r and ISO_r assumed)",
  "tail": "r = L .. alpha-1 (p_r >= p_{r+1} assumed)",
  "WR_r": "p_{r-1} <= r p_r",
  "ISO_r": "Q_r = r p_r^2 + p_{r-1}^2 - (r+1) p_{r-1} p_{r+1} >= 0",
  "unimodal": "exists m: p_0 <= ... <= p_m >= ... >= p_alpha (plateaus allowed)",
  "L_values_alpha_0_to_7": [
   0,
   1,
   1,
   2,
   3,
   3,
   4,
   5
  ],
  "L_matches_core_and_exact_ceiling_alpha<=500": true
 },
 "environment": {
  "python": "3.12.3",
  "sympy": "1.14.0",
  "seed": 993
 },
 "identities": {
  "ratio_identity": {
   "statement": "r*x + 1/x - (r + 1) == (r*x - 1)*(x - 1)/x",
   "sympy_simplify(lhs - rhs)": "0",
   "verified": true
  },
  "sign_certificate": {
   "parametrisation": "x = 1/r + t*(1 - 1/r), t in [0, 1] covers x in [1/r, 1]",
   "(r*x - 1)*(x - 1) in terms of t": "t*(r - 1)**2*(t - 1)/r",
   "manifestly <= 0 on t in [0,1]": "t*(t - 1) <= 0, (r - 1)^2/r >= 0, and x > 0",
   "sympy_simplify(cert - t*(t-1)*(r-1)**2/r)": "0",
   "verified": true,
   "conclusion": "for x in [1/r, 1]: r*x + 1/x <= r + 1"
  },
  "equality_cases": {
   "sympy_solve(r*x + 1/x = r + 1, x)": [
    "1",
    "1/r"
   ],
   "expected": [
    "1",
    "1/r"
   ],
   "verified": true,
   "remark": "for r = 1 the interval [1/r, 1] is the single point x = 1 (equality)"
  },
  "exact_rational_spot_check": {
   "grid": "r = 1..12, x = 1/r + (k/24)(1 - 1/r), k = 0..24",
   "r*x + 1/x <= r+1 everywhere, equality exactly at x in {1/r, 1}": true
  },
  "integer_identity_WR_times_descent": {
   "statement": "(r*p_r - p_{r-1})*(p_r - p_{r-1}) == r*p_r^2 + p_{r-1}^2 - (r+1)*p_{r-1}*p_r",
   "sympy_expand(lhs - rhs)": "0",
   "verified": true,
   "use": "WR_r (first factor >= 0) and a weak descent p_r <= p_{r-1} (second factor <= 0) give r*p_r^2 + p_{r-1}^2 <= (r+1)*p_{r-1}*p_r"
  },
  "integer_master_identity": {
   "statement": "(r+1)*p_{r-1}*(p_r - p_{r+1}) == Q_r + (r*p_r - p_{r-1})*(p_{r-1} - p_r)",
   "Q_r": "r*p_r^2 + p_{r-1}^2 - (r+1)*p_{r-1}*p_{r+1}",
   "sympy_expand(lhs - rhs)": "0",
   "verified": true,
   "use": "ISO_r (Q_r >= 0), WR_r (r*p_r - p_{r-1} >= 0) and a weak descent (p_{r-1} - p_r >= 0) make the right side >= 0; since (r+1)*p_{r-1} >= 1 the integer p_r - p_{r+1} is >= 0."
  },
  "ratio_form_of_ISO": {
   "statement": "Q_r/(p_{r-1}*p_r) == r*x + 1/x - (r+1)*y with x = p_r/p_{r-1}, y = p_{r+1}/p_r",
   "sympy_simplify(lhs - rhs)": "0",
   "verified": true,
   "handoff_chain": "WR_r: 1/r <= x; descent: x <= 1; ISO_r: (r+1)*y <= r*x + 1/x <= r+1; hence y <= 1"
  },
  "exhaustive_one_step_box": {
   "box": "r = 1..6, p_{r-1} = 1..12, p_r = 1..12, p_{r+1} = 1..24",
   "triples_with_WR_and_ISO_and_weak_descent": 1475,
   "all_have_p_{r+1} <= p_r": true
  },
  "all_verified": true
 },
