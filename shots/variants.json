[
  { "name": "a_full", "steps": 3 },
  {
    "name": "b_nogarments",
    "steps": 3,
    "eval": "(()=>{const s=window.__engine.set.scene;s.traverse(o=>{if(o.name&&/-(jacket|shirt|coat|trousers|vest|suit|tie|belt|strip|led)/.test(o.name))o.visible=false;});})()"
  },
  {
    "name": "c_bodyonly_dark",
    "steps": 3,
    "eval": "(()=>{const s=window.__engine.set.scene;s.traverse(o=>{if(/-body$/.test(o.name||'')){o.material.forEach?o.material.forEach(m=>{m.color.setHex(0x101317);m.clearcoat=0;m.sheen=0;}):(o.material.color.setHex(0x101317));}});})()"
  },
  {
    "name": "d_nobloom",
    "steps": 3,
    "eval": "(()=>{window.__engine.fx.setBloom(0.0,0.7,2.0);window.__engine.fx.setStreak(0.0);})()"
  }
]
