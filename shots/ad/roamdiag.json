    "eval": "(()=>{const e=window.__engine,s=e.set.scene,c=e.set.camera;const st={lights:[],rain:null,fog:s.fog,bloom:null};s.traverse(o=>{if(o.isLight)st.lights.push([o,o.intensity]);if(o.name==='rain')st.rain=o;});window.__st=st;window.__reset=()=>{for(const[l,i]of st.lights)l.intensity=i;if(st.rain)st.rain.visible=true;s.fog=st.fog;e.fx.setBloom(0.62,0.7,0.62);e.fx.setStreak(0.5);};window.__near=()=>{const c2=e.set.camera;let best=null,bd=1e9;for(const[l]of st.lights){if(!(l.isPointLight||l.isSpotLight))continue;const v=c2.position.clone();l.getWorldPosition(v);const d=v.distanceTo(c2.position);if(d<bd){bd=d;best=l;}}return best;};return 'ok';})()"
